{
  "name": "HelloWorld",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:clean-native": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force android/app/.cxx, android/app/build, android/build -ErrorAction SilentlyContinue; Write-Host 'Android native build cache cleared.'\"",
    "android:fix": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "api:use-production": "powershell -ExecutionPolicy Bypass -File ./scripts/use-production-api.ps1",
    "api:use-local": "powershell -ExecutionPolicy Bypass -File ./scripts/use-local-api.ps1",
    "api:sync-host": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-api-host.ps1",
    "api:sync-host-lan": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-api-host-lan.ps1",
    "api:firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/allow-firewall.ps1",
    "api:test": "node scripts/test-api-connection.js",
    "dev:setup": "npm run api:sync-host",
    "dev:connect": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-connect.ps1",
    "sync:all": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-all.ps1",
    "symfony:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-backend.ps1",
    "symfony:status": "cd ..\\..\\..\\florynn && symfony server:status",
    "android:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.8.4",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.1.2",
    "@react-native-community/cli-platform-ios": "^20.1.2",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
